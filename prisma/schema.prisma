// Schema da Fase 1 (Fundação) da migração do painel Santa Cruz Orçamentos.
// Fonte da verdade do modelo de dados atual: ESPECIFICACAO-sistema-atual.md, seção 1.
//
// `perfis` e `usuarios` reproduzem fielmente os campos de hoje (seção 4).
// `orcamentos` e `anexos` existem como esqueleto relacional simplificado — os objetos
// aninhados por etapa (reqCliente, reqTecnicos, precificacao, leituraAnterior) ficam em
// Json por enquanto e ganham modelagem relacional própria na Fase 2 (fluxo de 6 etapas).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- perfis de acesso ----------

model Perfil {
  id       String   @id @default(cuid())
  nome     String
  admin    Boolean  @default(false)
  // Chaves de Area (ver src/lib/areas.ts) que este perfil pode EDITAR.
  // Todo mundo logado sempre VÊ o painel inteiro — isto só controla onde pode salvar/alterar.
  areas    String[] @default([])
  criadoEm DateTime @default(now())

  usuarios Usuario[]

  @@map("perfis")
}

// ---------- usuários ----------

model Usuario {
  id       String   @id @default(cuid())
  nome     String
  // PIN de 4-6 dígitos, hasheado com bcrypt — nunca gravado em texto puro
  // (corrige o risco descrito na seção 8 da especificação).
  pinHash  String
  perfilId String
  perfil   Perfil   @relation(fields: [perfilId], references: [id])
  // false bloqueia o login sem apagar o histórico da pessoa.
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  orcamentosCriados Orcamento[] @relation("OrcamentoCriadoPor")
  anexosEnviados    Anexo[]     @relation("AnexoEnviadoPor")

  @@map("usuarios")
}

// ---------- orçamentos (esqueleto — fluxo completo entra na Fase 2) ----------

enum OrigemOrcamento {
  NOVO
  LEGADO
}

enum EtapaOrcamento {
  ABERTO
  ENGENHARIA
  ORCAMENTO
  DIRETORIA
  ENVIO_OFERTA
  FINALIZADO
}

enum StatusDiretoria {
  AUTO_APROVADO
  PENDENTE
  APROVADO
  REVISAO
  LEGADO
}

enum Classificacao {
  NOVO
  REPETICAO_SEM_ALTERACAO
  REPETICAO_COM_ALTERACAO
  REPETICAO_NOVO
}

model Orcamento {
  id               String           @id @default(cuid())
  origem           OrigemOrcamento  @default(NOVO)

  cliente          String?
  clienteChave     String?
  produtoDescricao String?
  produtoCodigo    String?
  produtoChave     String?
  codInterno       String?
  numeroSequencial String?
  preCadastro      String?
  numeroOrcamento  String?
  classificacao    Classificacao?

  etapa            EtapaOrcamento?  // null nos registros de origem "legado"
  statusDiretoria  StatusDiretoria?

  // Específicos do Arquivo legado (origem = LEGADO) — seção 1 da especificação.
  precoAtual       Decimal?         @db.Decimal(12, 2)
  custoPrimarioPct Decimal?         @db.Decimal(5, 2)
  margemP2Pct      Decimal?         @db.Decimal(5, 2)
  quantidade       Decimal?         @db.Decimal(12, 2)
  dataLegadoTexto  String?
  obs              String?
  fotoDados        String?          @db.Text
  fotoMime         String?

  // Objetos aninhados por etapa — Json nesta fase, viram tabelas próprias na Fase 2.
  reqCliente       Json?
  reqTecnicos      Json?
  precificacao     Json?
  leituraAnterior  Json?

  criadoPorId      String?
  criadoPor        Usuario?         @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id])
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt

  anexos           Anexo[]

  @@map("orcamentos")
}

// ---------- anexos ----------

enum TipoAnexo {
  ARTE
  ENGENHARIA
}

model Anexo {
  id           String    @id @default(cuid())
  orcamentoId  String
  orcamento    Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  tipo         TipoAnexo
  nome         String
  mime         String
  tamanho      Int
  // Data URL do arquivo — mesma limitação de hoje (~180kB); storage de arquivo de verdade é
  // item da Fase 2 (ver seção 8, limitação "Anexos limitados a ~180 KB por arquivo").
  dados        String    @db.Text
  enviadoPorId String?
  enviadoPor   Usuario?  @relation("AnexoEnviadoPor", fields: [enviadoPorId], references: [id])
  enviadoEm    DateTime  @default(now())

  @@map("anexos")
}
